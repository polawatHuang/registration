# ห้าม commit ไฟล์ .env จริง   สร้างกุญแจด้วย: npm run keys:generate
NODE_ENV=production
PORT=3000
APP_URL=https://training.example.com
# จำนวน reverse proxy หน้า Node (Plesk nginx = 1)
TRUST_PROXY=1

DB_HOST=localhost
DB_PORT=3306
DB_NAME=line_smart_training
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=8

# 32 ไบต์ แบบ base64 (ถ้าหายจะถอดรหัสข้อมูล/เอกสารเดิมไม่ได้ ต้องสำรองแยกจาก DB)
DATA_ENCRYPTION_KEY=
# คนละค่ากับ DATA_ENCRYPTION_KEY ใช้ทำดัชนีค้นหาเลขบัตร
DATA_HASH_KEY=
# ใช้กับ Plesk Scheduled Task
JOBS_SECRET=
# 1 = แอปรันงานตั้งเวลาเองทุก 5 นาที (ค่าเริ่มต้น) 0 = ใช้ Scheduled Task อย่างเดียว
JOBS_IN_APP=1

# ต้องอยู่นอก Document Root (frontend/)
STORAGE_PATH=./storage
MAX_UPLOAD_MB=5

# ค่าต่อไปนี้ตั้งได้จากหน้า Admin > ตั้งค่า (เข้ารหัสใน DB และใช้แทนค่าในไฟล์นี้)
# LINE Login (Callback URL = APP_URL + /api/v1/auth/line/callback)
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# LINE Official Account
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LIFF_ID=

# อีเมลยืนยันการสมัคร (ใช้กล่องอีเมลใน Plesk ได้)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=

# MiniMax เท่านั้น
MINIMAX_API_KEY=
MINIMAX_BASE_URL=
MINIMAX_MODEL=

TIMEZONE=Asia/Bangkok
LOG_LEVEL=info
